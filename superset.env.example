# -----------------------------------------------------------------------------
# Single Sign-On via OpenID Connect (OIDC)
#
# Diese Datei nach "superset.env" kopieren und ausfuellen. Sobald OIDC_CLIENT_ID
# gesetzt ist, verwendet Superset SSO statt Benutzer/Passwort-Login.
# "superset.env" ist per .gitignore vom Repo ausgeschlossen (enthaelt Secrets).
#
# Redirect-/Callback-URL im Identity Provider eintragen:
#     http(s)://<host>:8088/oauth-authorized/oidc
# -----------------------------------------------------------------------------

# --- Pflicht -----------------------------------------------------------------
OIDC_CLIENT_ID=superset
OIDC_CLIENT_SECRET=dein-client-secret

# Discovery-URL (endet auf /.well-known/openid-configuration):
#   Keycloak:  https://<host>/realms/<realm>/.well-known/openid-configuration
#   Azure AD:  https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
#   Google:    https://accounts.google.com/.well-known/openid-configuration
#   Okta:      https://<domain>/.well-known/openid-configuration
#   Authentik: https://<host>/application/o/<slug>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=https://keycloak.example.com/realms/master/.well-known/openid-configuration

# --- Optional ----------------------------------------------------------------
# Angeforderte Scopes (ggf. "groups" ergaenzen, wenn Rollen-Mapping genutzt wird)
OIDC_SCOPE=openid email profile

# Standardrolle fuer neue SSO-Nutzer ohne passendes Gruppen-Mapping
OIDC_DEFAULT_ROLE=Gamma

# Werte des roles-/groups-Claims, die auf Superset-Rollen gemappt werden.
# Nutzer in dieser IdP-Gruppe werden zu Superset-Admins bzw. -Usern.
OIDC_ADMIN_GROUP=superset_admins
OIDC_USER_GROUP=superset_users
